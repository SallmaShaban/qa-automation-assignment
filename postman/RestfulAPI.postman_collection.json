{
  "info": {
    "_postman_id": "saucedemo-api-test-collection",
    "name": "Restful API Test Collection",
    "description": "API testing collection for restful-api.dev",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST - Create Object",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let jsonData = null;",
              "try {",
              "    jsonData = pm.response.json();",
              "} catch (e) {}",
              "",
              "pm.test('Response has id field', function () {",
              "    pm.expect(jsonData, 'Response body should be valid JSON').to.be.an('object');",
              "    pm.expect(jsonData).to.have.property('id');",
              "});",
              "",
              "pm.test('Response has name field', function () {",
              "    pm.expect(jsonData, 'Response body should be valid JSON').to.be.an('object');",
              "    pm.expect(jsonData).to.have.property('name');",
              "});",
              "",
              "// Save object ID for subsequent tests",
              "if (jsonData && jsonData.id) {",
              "    pm.environment.set('objectId', jsonData.id);",
              "    pm.environment.set('objectName', jsonData.name || 'Test Object');",
              "    pm.collectionVariables.set('objectId', jsonData.id);",
              "    pm.collectionVariables.set('objectName', jsonData.name || 'Test Object');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Test Object\",\"data\":{\"year\":2024,\"price\":999.99,\"CPU model\":\"Intel Core i9\"}}"
        },
        "url": {
          "raw": "{{baseUrl}}/objects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "objects"
          ]
        }
      }
    },
    {
      "name": "GET - Retrieve Created Object",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData = null;",
              "try {",
              "    jsonData = pm.response.json();",
              "} catch (e) {}",
              "",
              "const expectedId = pm.environment.get('objectId') || pm.collectionVariables.get('objectId');",
              "const expectedName = pm.environment.get('objectName') || pm.collectionVariables.get('objectName');",
              "",
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Object ID matches created object', function () {",
              "    pm.expect(expectedId, 'Created Object ID should not be empty').to.be.a('string').and.not.empty;",
              "    pm.expect(jsonData, 'Response body should be valid JSON').to.be.an('object');",
              "    pm.expect(jsonData.id).to.equal(expectedId);",
              "});",
              "",
              "pm.test('Object name matches created name', function () {",
              "    pm.expect(expectedName, 'Created Object Name should not be empty').to.be.a('string').and.not.empty;",
              "    pm.expect(jsonData, 'Response body should be valid JSON').to.be.an('object');",
              "    pm.expect(jsonData.name).to.equal(expectedName);",
              "});",
              "",
              "pm.test('Response contains data object', function () {",
              "    pm.expect(jsonData, 'Response body should be valid JSON').to.be.an('object');",
              "    pm.expect(jsonData).to.have.property('data');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/objects/{{objectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "objects",
            "{{objectId}}"
          ]
        }
      }
    },
    {
      "name": "PUT - Update Object Property",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData = null;",
              "try {",
              "    jsonData = pm.response.json();",
              "} catch (e) {}",
              "",
              "const expectedId = pm.environment.get('objectId') || pm.collectionVariables.get('objectId');",
              "",
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Object name is updated correctly', function () {",
              "    pm.expect(jsonData, 'Response body should be valid JSON').to.be.an('object');",
              "    pm.expect(jsonData.name).to.equal('Updated Test Object');",
              "});",
              "",
              "pm.test('Object ID remains the same', function () {",
              "    pm.expect(expectedId, 'Created Object ID should not be empty').to.be.a('string').and.not.empty;",
              "    pm.expect(jsonData, 'Response body should be valid JSON').to.be.an('object');",
              "    pm.expect(jsonData.id).to.equal(expectedId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Updated Test Object\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/objects/{{objectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "objects",
            "{{objectId}}"
          ]
        }
      }
    },
    {
      "name": "DELETE - Delete Object",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData = null;",
              "try {",
              "    jsonData = pm.response.json();",
              "} catch (e) {}",
              "",
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains confirmation message', function () {",
              "    pm.expect(jsonData, 'Response body should be valid JSON').to.be.an('object');",
              "    pm.expect(jsonData).to.have.property('message');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/objects/{{objectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "objects",
            "{{objectId}}"
          ]
        }
      }
    },
    {
      "name": "GET - Verify Deleted Object",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Deleted object returns 404 error', function () {",
              "    // After deletion, attempting to retrieve should return an error",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/objects/{{objectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "objects",
            "{{objectId}}"
          ]
        }
      }
    },
    {
      "name": "GET - Negative Test: Invalid Object ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData = null;",
              "try {",
              "    jsonData = pm.response.json();",
              "} catch (e) {}",
              "",
              "pm.test('Invalid object ID returns error', function () {",
              "    // Requesting a non-existent object should return 404",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Error response contains error message', function () {",
              "    pm.expect(jsonData, 'Response body should be valid JSON').to.be.an('object');",
              "    pm.expect(jsonData).to.have.property('error');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/objects/invalid-id-12345",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "objects",
            "invalid-id-12345"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.restful-api.dev",
      "type": "string"
    },
    {
      "key": "objectId",
      "value": "",
      "type": "string"
    },
    {
      "key": "objectName",
      "value": "",
      "type": "string"
    }
  ]
}
