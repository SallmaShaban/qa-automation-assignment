{
  "name": "qa-automation-assignment",
  "version": "1.0.0",
  "description": "Mid-level QA automation engineer assignment - UI and API testing",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "api:test": "newman run postman/RestfulAPI.postman_collection.json -e postman/RestfulAPI.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export newman/newman-report.html --timeout-request 60000 --delay-request 300",
    "api:test:html": "newman run postman/RestfulAPI.postman_collection.json -e postman/RestfulAPI.postman_environment.json --reporters htmlextra --reporter-htmlextra-export newman/newman-report.html --timeout-request 60000 --delay-request 300",
    "lint": "eslint . --ext .ts,.js",
    "clean": "rm -rf test-results/ playwright-report/ newman/newman-run-report-*.html"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "qa"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "newman": "^6.1.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "typescript": "^5.5.4"
  }
}
